# Browser-safe configuration
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=false

# Server configuration (place in server/.env)
PORT=5173

# Optional: Custom AI Provider API Keys
# If any of these are set, HAMA CODER routes generations through your provider.
# If none are set, HAMA CODER automatically uses the free LlamaCoder upstream proxy with zero setup!
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# TOGETHER_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434

# Default LlamaCoder Configuration (when no custom API key is set)
# LLAMACODER_BASE_URL=https://llamacoder.together.ai
# LLAMACODER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
